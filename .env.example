# SQLite is the only persistence backend through Milestone 3.
ALPHA_LAB_DATABASE_URL=sqlite:///alpha_lab.db
ALPHA_LAB_LOG_LEVEL=INFO

# Milestone 2 proposal-only LLM. Leave unset for fully offline replay use.
ALPHA_LAB_LLM_API_KEY=
ALPHA_LAB_LLM_MODEL=
ALPHA_LAB_LLM_BASE_URL=
ALPHA_LAB_LLM_TEMPERATURE=0
ALPHA_LAB_LLM_TIMEOUT_SECONDS=60

# Milestone 3 authorized BRAIN adapter. Keep the session file outside this repository,
# restrict it to the owning user (chmod 600), and leave this unset for offline use.
ALPHA_LAB_BRAIN_SESSION_FILE=
ALPHA_LAB_BRAIN_BASE_URL=https://api.worldquantbrain.com
ALPHA_LAB_BRAIN_TIMEOUT_SECONDS=60
ALPHA_LAB_BRAIN_MAX_RETRY_AFTER_SECONDS=60

# Endpoint paths are configurable because authorized BRAIN deployments may differ.
ALPHA_LAB_BRAIN_AUTHENTICATION_PATH=/authentication
ALPHA_LAB_BRAIN_DATASETS_PATH=/data-sets
ALPHA_LAB_BRAIN_FIELDS_PATH=/data-fields
ALPHA_LAB_BRAIN_OPERATORS_PATH=/operators
ALPHA_LAB_BRAIN_SETTINGS_PATH=/settings
ALPHA_LAB_BRAIN_SIMULATIONS_PATH=/simulations
ALPHA_LAB_BRAIN_ALPHAS_PATH=/alphas

# Milestone 4 local stdio MCP server. These paths are fixed by the operator and are
# never accepted as MCP tool arguments. Prefer absolute paths in host configuration.
ALPHA_LAB_MCP_DATABASE_PATH=
ALPHA_LAB_MCP_REPLAY_FIXTURE=
