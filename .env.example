# Copy to .env (git-ignored), fill in what you use, then load it into your shell:
#   set -a; source .env; set +a
# Every value is optional; leave a line empty to use the default.

# ---- alpha-factory (current runtime) ----
# LLM key. When unset, the key is read from llm.key_file in factory.yaml.
ALPHA_FACTORY_LLM_API_KEY=
# Platform login. When unset, BRAIN_CREDENTIALS_FILE (default
# ~/secrets/platform-brain.json, a JSON {"email": ..., "password": ...}) is read.
ALPHA_LAB_BRAIN_USERNAME=
ALPHA_LAB_BRAIN_PASSWORD=
BRAIN_CREDENTIALS_FILE=

# ---- alpha-lab (legacy orchestrator) ----
# SQLite is the only persistence backend.
ALPHA_LAB_DATABASE_URL=sqlite:///alpha_lab.db
ALPHA_LAB_LOG_LEVEL=INFO

# Proposal-only LLM. Leave unset for fully offline replay use.
ALPHA_LAB_LLM_API_KEY=
ALPHA_LAB_LLM_MODEL=
ALPHA_LAB_LLM_BASE_URL=
ALPHA_LAB_LLM_TEMPERATURE=0
ALPHA_LAB_LLM_TIMEOUT_SECONDS=60

# Live platform adapter. Keep the session file outside this repository and
# readable only by you (chmod 600); leave unset for offline use.
ALPHA_LAB_BRAIN_SESSION_FILE=
ALPHA_LAB_BRAIN_BASE_URL=https://api.worldquantbrain.com
ALPHA_LAB_BRAIN_TIMEOUT_SECONDS=60
ALPHA_LAB_BRAIN_MAX_RETRY_AFTER_SECONDS=60

# Endpoint paths are configurable because deployments may differ.
ALPHA_LAB_BRAIN_AUTHENTICATION_PATH=/authentication
ALPHA_LAB_BRAIN_DATASETS_PATH=/data-sets
ALPHA_LAB_BRAIN_FIELDS_PATH=/data-fields
ALPHA_LAB_BRAIN_OPERATORS_PATH=/operators
ALPHA_LAB_BRAIN_SETTINGS_PATH=/settings
ALPHA_LAB_BRAIN_SIMULATIONS_PATH=/simulations
ALPHA_LAB_BRAIN_ALPHAS_PATH=/alphas

# Local stdio MCP server. Fixed by the operator, never accepted as tool arguments.
ALPHA_LAB_MCP_DATABASE_PATH=
ALPHA_LAB_MCP_REPLAY_FIXTURE=
